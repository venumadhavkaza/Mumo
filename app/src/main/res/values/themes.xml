<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
         Single app-wide theme, used by every Activity (set at the <application> level).
         Built from Mumo's own calming palette (colors.xml) mapped onto Material 3 roles,
         instead of each screen falling back to a different unstyled default theme.
    -->
    <style name="Theme.Mumo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorOfStatusBar</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorAccent</item>
        <item name="colorOnPrimaryContainer">@color/colorOfStatusBar</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/colorPrimary</item>
        <item name="colorOnSecondaryContainer">@color/colorOfStatusBar</item>

        <item name="android:colorBackground">@color/colorPrimary</item>
        <item name="colorSurface">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/colorOfStatusBar</item>
        <item name="colorOnBackground">@color/colorOfStatusBar</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/colorOfStatusBar</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/colorOfStatusBar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="27">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Mumo.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Mumo.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Mumo.Large</item>
    </style>

    <!-- Soft, rounded shapes for a calmer, less boxy feel across buttons/cards/sheets. -->
    <style name="ShapeAppearance.Mumo.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Mumo.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Mumo.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
