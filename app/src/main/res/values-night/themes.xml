<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark-mode counterpart of values/themes.xml, same brand palette, same style name. -->
    <style name="Theme.Mumo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/colorOfStatusBar</item>
        <item name="colorPrimaryContainer">@color/colorOfStatusBar</item>
        <item name="colorOnPrimaryContainer">@color/colorAccent</item>

        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorOnSecondary">@color/colorOfStatusBar</item>
        <item name="colorSecondaryContainer">@color/colorOfStatusBar</item>
        <item name="colorOnSecondaryContainer">@color/colorPrimary</item>

        <item name="android:colorBackground">@color/colorOfStatusBar</item>
        <item name="colorSurface">@color/colorOfStatusBar</item>
        <item name="colorOnSurface">@color/colorPrimary</item>
        <item name="colorOnBackground">@color/colorPrimary</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/colorOfStatusBar</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/colorOfStatusBar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="27">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Mumo.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Mumo.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Mumo.Large</item>
    </style>

    <style name="ShapeAppearance.Mumo.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Mumo.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Mumo.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
